datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

enum LeadType {
  CONTACT
  QUOTE
  NEWSLETTER
}

enum LeadStatus {
  NEW
  CONTACTED
  CLOSED
}

model Lead {
  id             String     @id @default(uuid())
  type           LeadType
  status         LeadStatus @default(NEW)
  email          String
  name           String?
  phone          String?
  subject        String?
  message        String?
  
  // Fields specific to Quote requests
  budget         String?
  timeline       String?
  service        String?
  projectDetails String?
  fileUrl        String?    // S3 URL for attached requirements document
  
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@map("leads")
}

model Service {
  id          String   @id @default(uuid())
  title       String
  description String
  icon        String
  body        String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("services")
}

model BlogPost {
  id               String   @id @default(uuid())
  title            String
  slug             String   @unique @default(uuid())
  shortDescription String?
  category         String
  status           String   // "Draft" | "Published"
  tags             String
  thumbnail        String?
  content          String
  seoTitle         String?
  seoDescription   String?
  readTime         Int?
  authorName       String?
  publishDate      DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("blog_posts")
}

model PortfolioProject {
  id               String   @id @default(uuid())
  title            String
  client           String
  category         String
  websiteUrl       String?
  description      String
  gallery          String?  // comma-separated urls
  coverImage       String?
  industry         String?
  servicesUsed     String?  // JSON string or comma-separated
  technologiesUsed String?  // JSON string or comma-separated
  teamMembers      String?  // JSON string or comma-separated
  duration         String?
  projectStatus    String?  // e.g. "Completed", "In Progress"
  projectOverview  String?
  challenges       String?
  solution         String?
  features         String?  // JSON string
  results          String?
  metrics          String?  // JSON string
  testimonial      String?
  cta              String?
  seoTitle         String?
  seoDescription   String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("portfolio_projects")
}

model CaseStudy {
  id                 String   @id @default(uuid())
  slug               String   @unique
  title              String
  heroBanner         String?
  coverImage         String?
  clientName         String?
  industry           String?
  problemStatement   String?
  businessChallenges String?
  objectives         String?
  research           String?
  strategy           String?
  solution           String?
  architecture       String?
  designProcess      String?
  developmentJourney String?
  technologies       String?  // JSON string or comma-separated
  beforeVsAfter      String?  // JSON string
  kpis               String?  // JSON string
  charts             String?  // JSON string
  roi                String?
  results            String?
  clientTestimonial  String?
  media              String?  // JSON string for images/videos
  downloadPdfUrl     String?
  cta                String?
  seoTitle           String?
  seoDescription     String?
  status             String   @default("DRAFT") // "DRAFT" | "PUBLISHED"
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@map("case_studies")
}

model NewsletterSubscriber {
  id           String   @id @default(uuid())
  email        String   @unique
  name         String?
  status       String   @default("ACTIVE") // "ACTIVE" | "UNSUBSCRIBED"
  subscribedAt DateTime @default(now())

  @@map("newsletter_subscribers")
}

model NewsletterCampaign {
  id           String   @id @default(uuid())
  subject      String
  bannerImage  String?
  content      String
  status       String   @default("DRAFT") // "DRAFT" | "SCHEDULED" | "SENT"
  scheduledFor DateTime?
  sentAt       DateTime?
  stats        String?  // JSON string { totalSent, delivered, failed, opens, clicks }
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("newsletter_campaigns")
}

model TeamMember {
  id        String   @id @default(uuid())
  name      String
  role      String
  email     String?
  bio       String?
  linkedin  String?
  twitter   String?
  github    String?
  photo     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("team_members")
}

model JobApplication {
  id             String   @id @default(uuid())
  candidateName  String
  email          String
  phone          String?
  roleAppliedFor String
  resumeUrl      String?  // File upload link
  coverLetter    String?
  status         String   @default("NEW") // "NEW", "REVIEWED", "INTERVIEW", "REJECTED"
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("job_applications")
}

model Job {
  id          String   @id @default(uuid())
  title       String
  department  String
  location    String
  type        String
  description String
  requirements String?  // JSON string or newline-separated
  status      String   @default("OPEN") // "OPEN", "CLOSED"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("jobs")
}
