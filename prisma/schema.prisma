datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

enum LeadType {
  CONTACT
  QUOTE
  NEWSLETTER
}

enum LeadStatus {
  NEW
  CONTACTED
  CLOSED
}

model Lead {
  id             String     @id @default(uuid())
  type           LeadType
  status         LeadStatus @default(NEW)
  email          String
  name           String?
  phone          String?
  subject        String?
  message        String?
  
  // Fields specific to Quote requests
  budget         String?
  timeline       String?
  service        String?
  projectDetails String?
  fileUrl        String?    // S3 URL for attached requirements document
  
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@map("leads")
}

model Service {
  id          String   @id @default(uuid())
  title       String
  description String
  icon        String
  body        String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("services")
}

model BlogPost {
  id        String   @id @default(uuid())
  title     String
  category  String
  status    String   // "Draft" | "Published"
  tags      String
  thumbnail String?
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("blog_posts")
}

model PortfolioProject {
  id          String   @id @default(uuid())
  title       String
  client      String
  category    String
  websiteUrl  String?
  description String
  gallery     String?  // comma-separated urls
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("portfolio_projects")
}

model TeamMember {
  id        String   @id @default(uuid())
  name      String
  role      String
  email     String?
  bio       String?
  linkedin  String?
  twitter   String?
  github    String?
  photo     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("team_members")
}
