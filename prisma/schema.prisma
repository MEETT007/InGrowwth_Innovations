datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

enum LeadType {
  CONTACT
  QUOTE
  NEWSLETTER
}

enum LeadStatus {
  NEW
  CONTACTED
  CLOSED
}

enum BlogPostStatus {
  Draft
  Published
}

enum CaseStudyStatus {
  DRAFT
  PUBLISHED
}

enum NewsletterSubscriberStatus {
  ACTIVE
  UNSUBSCRIBED
}

enum NewsletterCampaignStatus {
  DRAFT
  SCHEDULED
  SENT
}

enum JobApplicationStatus {
  NEW
  REVIEWED
  INTERVIEW
  REJECTED
}

enum JobStatus {
  OPEN
  CLOSED
}

model Lead {
  id      String     @id @default(uuid())
  type    LeadType
  status  LeadStatus @default(NEW)
  email   String
  name    String?
  phone   String?
  subject String?
  message String?

  // Fields specific to Quote requests
  budget         String?
  timeline       String?
  service        String?
  projectDetails String?
  fileUrl        String? // S3 URL for attached requirements document

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([status])
  @@index([createdAt])
  @@map("leads")
}

model IdempotencyKey {
  id        String   @id @default(uuid())
  scope     String
  key       String
  createdAt DateTime @default(now())

  @@unique([scope, key])
  @@index([createdAt])
  @@map("idempotency_keys")
}

model Service {
  id          String   @id @default(uuid())
  slug        String?  @unique
  title       String
  description String
  icon        String
  content     String @default("")
  features    Json?
  process     Json?
  techStack   Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([slug])
  @@index([createdAt])
  @@map("services")
}

model BlogPost {
  id               String         @id @default(uuid())
  title            String
  slug             String         @unique @default(uuid())
  shortDescription String?
  category         String
  status           BlogPostStatus
  tags             String
  thumbnail        String?
  content          String
  seoTitle         String?
  seoDescription   String?
  readTime         Int?
  authorName       String?
  publishDate      DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([slug])
  @@index([status])
  @@index([category])
  @@index([createdAt])
  @@map("blog_posts")
}

model PortfolioProject {
  id               String   @id @default(uuid())
  slug             String?  @unique
  title            String
  client           String
  category         String
  websiteUrl       String?
  description      String
  gallery          String? // comma-separated urls
  coverImage       String?
  industry         String?
  servicesUsed     String? // JSON string or comma-separated
  technologiesUsed String? // JSON string or comma-separated
  teamMembers      String? // JSON string or comma-separated
  duration         String?
  projectStatus    String? // e.g. "Completed", "In Progress"
  projectOverview  String?
  challenges       String?
  solution         String?
  features         String? // JSON string
  results          String?
  metrics          String? // JSON string
  testimonial      String?
  cta              String?
  seoTitle         String?
  seoDescription   String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([category])
  @@index([projectStatus])
  @@index([createdAt])
  @@map("portfolio_projects")
}

model CaseStudy {
  id                 String          @id @default(uuid())
  slug               String          @unique
  title              String
  heroBanner         String?
  coverImage         String?
  clientName         String?
  industry           String?
  problemStatement   String?
  businessChallenges String?
  objectives         String?
  research           String?
  strategy           String?
  solution           String?
  architecture       String?
  designProcess      String?
  developmentJourney String?
  technologies       String? // JSON string or comma-separated
  beforeVsAfter      String? // JSON string
  kpis               String? // JSON string
  charts             String? // JSON string
  roi                String?
  results            String?
  clientTestimonial  String?
  media              String? // JSON string for images/videos
  downloadPdfUrl     String?
  cta                String?
  seoTitle           String?
  seoDescription     String?
  status             CaseStudyStatus @default(DRAFT)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  @@index([slug])
  @@index([status])
  @@index([createdAt])
  @@map("case_studies")
}

model NewsletterSubscriber {
  id           String                     @id @default(uuid())
  email        String                     @unique
  name         String?
  status       NewsletterSubscriberStatus @default(ACTIVE)
  subscribedAt DateTime                   @default(now())

  @@index([email])
  @@index([status])
  @@index([subscribedAt])
  @@map("newsletter_subscribers")
}

model NewsletterCampaign {
  id           String                   @id @default(uuid())
  subject      String
  bannerImage  String?
  content      String
  status       NewsletterCampaignStatus @default(DRAFT)
  scheduledFor DateTime?
  sentAt       DateTime?
  stats        String? // JSON string { totalSent, delivered, failed, opens, clicks }
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt

  @@index([status])
  @@index([scheduledFor])
  @@map("newsletter_campaigns")
}

model TeamMember {
  id        String   @id @default(uuid())
  name      String
  role      String
  email     String?
  bio       String?
  linkedin  String?
  twitter   String?
  github    String?
  photo     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt])
  @@map("team_members")
}

model JobApplication {
  id             String               @id @default(uuid())
  candidateName  String
  email          String
  phone          String?
  roleAppliedFor String
  resumeUrl      String? // File upload link
  coverLetter    String?
  status         JobApplicationStatus @default(NEW)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@index([status])
  @@index([roleAppliedFor])
  @@index([createdAt])
  @@map("job_applications")
}

model Job {
  id           String    @id @default(uuid())
  title        String
  department   String
  location     String
  type         String
  description  String
  requirements String? // JSON string or newline-separated
  status       JobStatus @default(OPEN)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([status])
  @@index([department])
  @@index([createdAt])
  @@map("jobs")
}

// ==========================================
// AI Observability & Operations Platform
// ==========================================

model AiSession {
  id          String   @id @default(uuid())
  sessionId   String   @unique
  userId      String?
  totalTokens Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  messages    AiChatMessage[]

  @@index([sessionId])
  @@index([createdAt])
  @@map("ai_sessions")
}

model AiChatMessage {
  id          String     @id @default(uuid())
  sessionId   String
  session     AiSession  @relation(fields: [sessionId], references: [sessionId], onDelete: Cascade)
  role        String     // user, assistant, system
  content     String
  interactiveData Json?  // Stores Handoff Reason, requirements, etc.
  createdAt   DateTime   @default(now())

  @@index([sessionId])
  @@index([createdAt])
  @@map("ai_chat_messages")
}

model AiTrace {
  id          String   @id @default(uuid())
  sessionId   String
  query       String
  response    String?
  latency     Int      @default(0)
  status      String   @default("SUCCESS") // SUCCESS, FAILED
  error       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([sessionId])
  @@index([createdAt])
  @@map("ai_traces")
}

model AiEvent {
  id          String   @id @default(uuid())
  traceId     String
  stageName   String
  latency     Int      @default(0)
  rcoSnapshot Json?
  createdAt   DateTime @default(now())

  @@index([traceId])
  @@index([stageName])
  @@map("ai_events")
}

model PromptVersion {
  id           String   @id @default(uuid())
  name         String
  version      Int
  systemPrompt String
  isActive     Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@unique([name, version])
  @@index([name])
  @@map("ai_prompt_versions")
}

model EvaluationRun {
  id                String   @id @default(uuid())
  dataset           String
  scoreGroundedness Float    @default(0)
  scoreRelevance    Float    @default(0)
  avgLatency        Int      @default(0)
  details           Json?
  createdAt         DateTime @default(now())

  @@index([createdAt])
  @@map("ai_evaluation_runs")
}

// ==========================================
// AI Security & Governance
// ==========================================

model AuditLog {
  id           String   @id @default(uuid())
  action       String   // e.g. "PROMPT_INJECTION_DETECTED", "FILE_UPLOAD_REJECTED"
  severity     String   // INFO, WARNING, CRITICAL
  resourceId   String?  // The traceId or fileId involved
  userId       String?
  ipAddress    String?
  details      Json?
  createdAt    DateTime @default(now())

  @@index([action])
  @@index([severity])
  @@index([createdAt])
  @@map("ai_audit_logs")
}

model ApiQuota {
  id               String   @id @default(uuid())
  identifier       String   @unique // SessionId or UserId
  requestsCount    Int      @default(0)
  tokensUsed       Int      @default(0)
  limitRequests    Int      @default(100)
  limitTokens      Int      @default(50000)
  resetAt          DateTime
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([identifier])
  @@index([resetAt])
  @@map("ai_api_quotas")
}
