# Server Configuration
SECRET_KEY=your-secure-random-secret-key
PORT=5000
# For production, set to False
FLASK_DEBUG=False
# Comma-separated allowed origins for CORS
CORS_ALLOWED_ORIGINS=https://www.ingrowwthinnovations.in,https://your-frontend-domain.com

# Email Configuration (SMTP)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
MAIL_USE_TLS=true
MAIL_USE_SSL=false
SENDER_EMAIL=your-company-email@gmail.com
SENDER_PASSWORD=your-app-specific-password
MAIL_DEFAULT_SENDER=Your Company Name <your-company-email@gmail.com>

# Internal Alerts
# Who receives contact forms and career applications? (Comma-separated)
RECEIVER_EMAIL=admin@ingrowwth.in,hr@ingrowwth.in

# Database
# SQLite is used by default. For backups to work, ensure persistent storage for Backend/
DATABASE_URL=sqlite:///site.db

# Firebase Configuration (Optional but recommended for Resume storage)
# You can either provide the path to the JSON file OR the base64 encoded content
FIREBASE_SERVICE_ACCOUNT=path/to/service-account.json
# FIREBASE_SA_BASE64=... (Base64 encoded content of the JSON file, useful for Render/Heroku)
FIREBASE_BUCKET=your-bucket-name.appspot.com
FIREBASE_PROJECT_ID=your-project-id
