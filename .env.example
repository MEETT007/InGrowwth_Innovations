# ==============================================================================
# InGrowwth Innovations - Environment Variables Configuration Template
# ==============================================================================
# Copy this file to '.env' or '.env.local' depending on your usage.
# DO NOT commit '.env' or '.env.local' to git.

# ------------------------------------------------------------------------------
# APP ENVIRONMENT
# ------------------------------------------------------------------------------
# APP_ENV: Must be "development" or "production". Determines logging, safe seed, email restrictions.
APP_ENV="development"
# LOG_ENABLED (server) / NEXT_PUBLIC_LOG_ENABLED (client): "true" or "false" to enable/disable logging.
LOG_ENABLED="true"
NEXT_PUBLIC_LOG_ENABLED="true"

# ------------------------------------------------------------------------------
# DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# POSTGRES_PASSWORD: The password for local docker-compose Postgres.
POSTGRES_PASSWORD="local_postgres_password"
# DATABASE_URL: Prisma connection string. Differs between dev/prod.
DATABASE_URL="postgresql://postgres:local_postgres_password@localhost:5435/ingrowwth?schema=public"

# ------------------------------------------------------------------------------
# NEXT.JS SITE CONFIGURATION
# ------------------------------------------------------------------------------
# NEXT_PUBLIC_APP_URL: Base URL of the app. Differs between dev/prod.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# AUTHENTICATION CONFIGURATION (Clerk)
# ------------------------------------------------------------------------------
# Clerk keys. Usually differ between dev/prod, grab them from Clerk dashboard.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxx"
CLERK_SECRET_KEY="sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxx"
# Routing settings for Clerk (usually the same in dev/prod)
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/admin/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/admin/sign-up"
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL="/admin"
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL="/admin"

# ------------------------------------------------------------------------------
# EMAIL SERVICE CONFIGURATION (Resend)
# ------------------------------------------------------------------------------
# RESEND_API_KEY: Resend API Key. Can be shared if using test domains, but usually differs.
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxx"
# MAIL_FROM: Address sending the emails.
MAIL_FROM="InGrowwth Innovations <onboarding@resend.dev>"
# MAIL_TO_ADMIN: Where admin notifications go.
MAIL_TO_ADMIN="admin@ingrowwth.com"

# ------------------------------------------------------------------------------
# AWS S3 STORAGE CONFIGURATION
# ------------------------------------------------------------------------------
# AWS access keys. Can be shared (dev uploads prefixed with dev/).
AWS_ACCESS_KEY_ID="AKIAxxxxxxxxxxxxxxxx"
AWS_SECRET_ACCESS_KEY="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# AWS_REGION: usually us-east-1 (can be shared)
AWS_REGION="us-east-1"
# AWS_BUCKET_NAME: target bucket (can be shared)
AWS_BUCKET_NAME="ingrowwth-assets"
